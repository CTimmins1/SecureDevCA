<h2>Tasks (Secure)</h2>
<p><a href="/tasks/new">Add New Task</a></p>

<% if (banner) { %>
  <!-- This banner is only used to show that login worked -->
  <p style="background:#def7d7; padding:10px;">
    Login successful. You are now on the <strong>Secure</strong> tasks page.
  </p>
<% } %>

<!-- Secure search form -->
<form method="get" action="/search" style="margin-bottom: 1rem;">
  <!--csrf token input again-->
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <!-- I still allow any text here, but on the secure branch the backend uses
       a parameterised SQL query and this value is HTML-escaped in the template. -->
  <input
    type="text"
    name="q"
    placeholder="Search tasks (secure)"
    value="<%= q %>"
  />
  <button type="submit">Search</button>
</form>

<!-- Reflected XSS demonstration (now fixed on the secure branch) -->
<% if (q && q.length > 0) { %>
  <p>
    You searched for:
    <!-- SECURE: <%= %> HTML-escapes the value, so <script> becomes harmless text. -->
    <strong><%= q %></strong>
  </p>
<% } %>

<ul>
  <% tasks.forEach(t => { %>
    <!-- I now link each task to its detail page.
         The detail page is where the stored XSS used to happen via comments,
         but on the secure branch the comment body is escaped in task.ejs. -->
    <li>
      Task <%= t.id %>:
      <a href="/task/<%= t.id %>"><%= t.title %></a>
    </li>
  <% }) %>
</ul>

<h3>DOM-Based XSS Demo (now fixed on the secure branch)</h3>

<p>
  On the insecure branch this page was vulnerable to DOM-based XSS. The
  <code>banner</code> query parameter was written straight into
  <code>innerHTML</code>, so a payload like the one below would execute
  JavaScript in the browser. An attacker could even retrieve cookie based info using the <code>(document.cookie) payload.</code>
</p>

<p>Example payload (worked on insecure branch):</p>
<pre>?banner=&lt;img src=x onerror="alert('DOM XSS')"&gt;</pre>

<p>
  On this secure branch I switched from <code>innerHTML</code> to
  <code>textContent</code>, so the same payload is now shown as text instead of
  running.
</p>

<div id="domBanner" style="margin-top: 10px; padding: 8px; border: 1px solid #ccc;"></div>

<script>
  // Secure DOM handling:
  // I still set it so reading the "banner" query parameter from the URL, but instead of
  // writing it to innerHTML I now use textContent so any HTML/JS is printed
  // as text instead of executing. This removes the DOM XSS.
  const params = new URLSearchParams(window.location.search);
  const bannerValue = params.get("banner");

  if (bannerValue) {
    // Secure branch: I use textContent so any HTML/JS in the banner
    // is shown as text instead of executing (DOM XSS removed).
    document.getElementById("domBanner").textContent = bannerValue;
  }
</script>
