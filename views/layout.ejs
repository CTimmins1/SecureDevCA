<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>SecureDevCa</title>
  </head>
  <body>
    <header>
      <h1>SecureDevCa — Insecure Version</h1>

      <nav>
        <% if (currentUser) { %>
          Logged in as <%= currentUser.email %> |
          <a href="/tasks">Tasks</a> |
          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login">Login</a>
        <% } %>
      </nav>

      <hr />
    </header>

    <!-- each page gets injected here -->
    <%- body %>
  </body>
</html>
