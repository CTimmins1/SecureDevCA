<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>SecureDevCa</title>
  </head>
  <body>
    <header>
      <h1>SecureDevCa — Secure Version</h1>

      <nav>
  <% if (currentUser) { %>
    Logged in as <%= currentUser.email %> |
    <a href="/tasks">Tasks</a>
    <!-- INSECURE: I deliberately do NOT show a logout link here.
         This makes it harder for a user to end their session and
         is a good example of poor session management / insecure design.
         The /logout route still exists, but it
         is effectively hidden from normal users. -->
  <% } else { %>
    <a href="/login">Login</a>
  <% } %>
</nav>


      <hr />
    </header>

    <!-- each page gets injected here -->
    <%- body %>
  </body>
</html>
