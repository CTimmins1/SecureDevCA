<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>SecureDevCa</title>
  </head>
  <body>
    <header>
      <h1>SecureDevCa — Secure Version</h1>

<nav>
  <% if (currentUser) { %>
    Logged in as <%= currentUser.email %> |
    <a href="/tasks">Tasks</a> |
    <a href="/logout">Logout</a>
    <!-- Secure branch:
         On the insecure branch I hid the logout link
         to demonstrate poor session management.
         On this secure branch I show it clearly 
         so users can easily end their session. -->
  <% } else { %>
    <a href="/login">Login</a>
  <% } %>
</nav>


      <hr />
    </header>

    <!-- each page gets injected here -->
    <%- body %>
  </body>
</html>
